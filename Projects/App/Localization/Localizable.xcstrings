      }
    },
    "%@ 파일은 아직 바꿀 수 없어요. 지금은 문서(PDF, DOCX, HWP, HWPX), 이미지(HEIC, JPG, PNG 등), 영상(MOV, MP4), 소리(MP3, M4A, WAV 등)를 바꿀 수 있어요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conv can't convert %@ files yet. It converts documents (PDF, DOCX, HWP, HWPX), images (HEIC, JPG, PNG and more), video (MOV, MP4) and audio (MP3, M4A, WAV and more)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일은 아직 바꿀 수 없어요. 지금은 문서(PDF, DOCX, HWP, HWPX), 이미지(HEIC, JPG, PNG 등), 영상(MOV, MP4), 소리(MP3, M4A, WAV 등)를 바꿀 수 있어요."
          }
        }
      }
    },
